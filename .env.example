# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. Neon works out of the box (the app uses the
# Neon serverless driver, which also speaks to any Postgres over TCP in dev).
DATABASE_URL=

# 32-byte key, base64. Encrypts calendar credentials at rest: a member's
# secret iCal URL grants read access to their entire calendar, so it is a
# credential, not a setting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Signs the member cookie that lets someone return and edit themselves
# without an account. Generate the same way as above.
SESSION_SECRET=

# ── Optional: Google Calendar ───────────────────────────────────────────────
# Leave these empty and the Google "connect" path stays hidden. The app is
# fully functional without it: members can paste a secret iCal URL, upload an
# .ics file, or just set sleep and working hours.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and add {BASE_URL}/api/google/callback as an
# authorized redirect URI. Scopes needed:
#   https://www.googleapis.com/auth/calendar.readonly
#   https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin, used to build OAuth redirect URIs and share links.
# Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically; set this only to
# override (e.g. a custom domain).
NEXT_PUBLIC_BASE_URL=
