# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. Neon works out of the box (the app uses the
# Neon serverless driver, which also speaks to any Postgres over TCP in dev).
DATABASE_URL=

# 32-byte key, base64. Encrypts calendar credentials at rest: a member's
# secret iCal URL grants read access to their entire calendar, so it is a
# credential, not a setting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Signs the member cookie that lets someone return and edit themselves
# without an account. Generate the same way as above.
SESSION_SECRET=

# ── Optional: Google Calendar ───────────────────────────────────────────────
# Leave both empty and the Google path stays completely hidden — no button, no
# route that can be reached. Overlap works without it: members can paste the
# secret iCal URL their provider already exposes, or set sleep and working
# hours and nothing else.
#
# Overlap requests exactly ONE scope:
#   https://www.googleapis.com/auth/calendar.freebusy
# That endpoint returns busy intervals and nothing else — no titles, no
# attendees, no locations. The promise that Overlap records *that* you are busy
# and never *what* is therefore enforced by the API surface itself, not by our
# restraint in ignoring fields we were handed. Adding the event to a calendar
# still goes through the .ics download, which needs no scope at all.
#
# Setup: see docs/GOOGLE-OAUTH-SETUP.md, which includes a prompt you can hand
# to a browser agent to do the Cloud Console work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

